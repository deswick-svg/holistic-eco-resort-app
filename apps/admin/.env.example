# Local API config. Copy to apps/admin/.env.local (gitignored).
# Next.js loads .env.local for next dev and next start.
# Do not prefix these with EXPO_PUBLIC_.
#
# Lambda does not read this file. Set the same names on the function
# in ap-south-1. Keep the region and Cognito ids identical to apps/mobile/.env.

AWS_REGION=ap-south-1
GUEST_HISTORY_COGNITO_USER_POOL_ID=
GUEST_HISTORY_COGNITO_CLIENT_ID=
# Must match the EXPO_PUBLIC_COGNITO_*_GROUP names in apps/mobile/.env.
COGNITO_GUEST_GROUP=Guests
COGNITO_EMPLOYEE_GROUP=Employees
GUEST_HISTORY_DYNAMODB_TABLE=holistic-eco-resort-guest-bookings-dev
SIMPLOTEL_HOTEL_ID=7849
# Host only. Paths stay /api/v1/hotel/{id}/voice-bot/...
SIMPLOTEL_API_BASE_URL=https://admin.simplotel.com
SIMPLOTEL_ACCESS_TOKEN=
SIMPLOTEL_BOOKING_ENABLED=false
SIMPLOTEL_DIRECT_BOOKING_ENABLED=false

# true on the beta Lambda hides the admin dashboard. false for local next dev.
BETA_API_ONLY=false

# Leave commented until a supervised invoice test.
# SIMPLOTEL_INVOICE_HOLD_VALUE=10
# SIMPLOTEL_INVOICE_HOLD_UNIT=MINUTES
# SIMPLOTEL_INVOICE_TEST_SECRET=
# SIMPLOTEL_INVOICE_TEST_GUEST_SUB=

{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "beta": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_RELEASE_CHANNEL": "beta",
        "EXPO_PUBLIC_AWS_REGION": "ap-south-1",
        "EXPO_PUBLIC_COGNITO_GUEST_GROUP": "Guests",
        "EXPO_PUBLIC_COGNITO_EMPLOYEE_GROUP": "Employees"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "play-internal": {
      "distribution": "store",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_RELEASE_CHANNEL": "beta",
        "EXPO_PUBLIC_AWS_REGION": "ap-south-1",
        "EXPO_PUBLIC_COGNITO_GUEST_GROUP": "Guests",
        "EXPO_PUBLIC_COGNITO_EMPLOYEE_GROUP": "Employees"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}

# Local phone config. Copy to apps/mobile/.env (gitignored).
# Expo loads that file for expo start. Do not put server secrets here.
#
# An EAS cloud build does not read this file. Set the same EXPO_PUBLIC_*
# names on the Expo preview environment before eas build.

EXPO_PUBLIC_AWS_REGION=ap-south-1
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
# Must match COGNITO_GUEST_GROUP and COGNITO_EMPLOYEE_GROUP in apps/admin/.env.local.
EXPO_PUBLIC_COGNITO_GUEST_GROUP=Guests
EXPO_PUBLIC_COGNITO_EMPLOYEE_GROUP=Employees

# Local Next.js API, or the Mumbai Lambda Function URL. No trailing slash.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
